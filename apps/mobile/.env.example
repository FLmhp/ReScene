# Copy this file to apps/mobile/.env.local (ignored by git) before starting Expo.
# EXPO_PUBLIC_* values are embedded in the bundle, so never put secrets here.
#
# Android emulator: 10.0.2.2 is the emulator's alias for the host loopback.
# Physical device: replace 10.0.2.2 with the host's LAN address (for example
# 192.168.1.20) and keep the same ports. The device must be on the same network.
#
# Unset values fall back to production (https://api.rescene.xyz and
# https://app.rescene.xyz) even in development builds.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3000

#!/bin/sh
# Fast local guard: rejects a non-conventional subject before the commit exists.
# The full history is checked in CI by scripts/check-commits.mjs.
subject=$(sed -n '1p' "$1")
case "$subject" in
  "Merge "*) exit 0 ;;
esac
if printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'; then
  exit 0
fi
echo "commit subject must match \"<type>(<scope>)?: <subject>\"" >&2
echo "types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
echo "got: $subject" >&2
exit 1

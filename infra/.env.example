RESCENE_ADMIN_EMAIL=admin@rescene.xyz
RESCENE_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
RESCENE_OSS_REGION=oss-cn-beijing
RESCENE_OSS_BUCKET=replace-me
RESCENE_OSS_ACCESS_KEY_ID=replace-me
RESCENE_OSS_ROLE_ARN=acs:ram::0000000000000000:role/rescene-sts

# 邮箱验证码（登录、忘记密码）。未配置时生产环境安全失败：仍返回 202，但不会发信。
RESCENE_ENV=production
RESCENE_SMTP_HOST=smtp.example.com
RESCENE_SMTP_PORT=465
RESCENE_SMTP_SECURITY=ssl
RESCENE_SMTP_USERNAME=noreply@example.com
RESCENE_SMTP_FROM=noreply@example.com
RESCENE_SMTP_PASSWORD=replace-me
# 也可以只提供密码文件，二选一：
# RESCENE_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
RESCENE_SMTP_TIMEOUT_SECONDS=10
RESCENE_EMAIL_CODE_TTL_MINUTES=10
RESCENE_EMAIL_CODE_COOLDOWN_SECONDS=60
RESCENE_EMAIL_CODE_HOURLY_LIMIT=5
RESCENE_EMAIL_CODE_MAX_ATTEMPTS=5
